# 示例：Render Blueprint。复制到仓库根并改名为 render.yaml，然后在 Render 控制台 New > Blueprint。
# 密钥（sync: false）需在控制台手动填写，不要写进仓库。
services:
  - type: web
    name: jarvis-holographic
    runtime: docker            # 使用仓库根的 Dockerfile
    dockerfilePath: ./Dockerfile
    plan: starter
    healthCheckPath: /api/health
    autoDeploy: false
    envVars:
      - key: NODE_ENV
        value: production
      - key: PORT
        value: "8787"
      - key: HOST
        value: 0.0.0.0
      # Render 在容器前有反向代理。1 跳通常适用；部署后用两个不同网络测试限流/日志里的 IP 再确认。
      - key: TRUST_PROXY
        value: "1"
      - key: HSTS
        value: "1"
      - key: ALLOWED_ORIGIN
        sync: false            # 例如 https://jarvis-holographic.onrender.com
      - key: LLM_BASE_URL
        value: https://api.deepseek.com
      - key: LLM_MODEL
        value: deepseek-chat
      - key: LLM_API_KEY
        sync: false
      - key: AMAP_KEY
        sync: false
      - key: AMAP_SECURITY_CODE
        sync: false
