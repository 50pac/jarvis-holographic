{
  "name": "jarvis-holographic-interface",
  "description": "Gesture- and voice-controlled holographic JARVIS HUD with React, Three.js, MediaPipe, and an Express proxy that keeps secret keys server-side.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"vite\" \"node server/index.js\"",
    "dev:web": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.9",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.16.6",
    "@react-three/postprocessing": "2.16.2",
    "express": "^5.2.1",
    "maath": "^0.10.8",
    "postprocessing": "6.35.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.164.1",
    "troika-three-text": "^0.52.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.3"
  }
}
