# Copy to .env.local (or .env) and fill in. Never commit real values.
# All of these are read by the Node proxy (server/) only - none reach the browser bundle
# except AMAP_KEY, which is served via /api/config (AMap JS keys are public by design;
# restrict it with a domain whitelist in the AMap console).

# --- Proxy server ---
PORT=8787

# --- LLM (DeepSeek, OpenAI-compatible) ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- AMap (Gaode) ---
# JS API key (public, exposed to the browser through /api/config)
AMAP_KEY=
# Security code (secret, stays on the server; injected by the /_AMapService proxy)
AMAP_SECURITY_CODE=
