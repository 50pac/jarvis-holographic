# Copy to .env.local (or .env) and fill in. Never commit real values.
# Runtime values are read by the Node proxy (server/); HOST_PORT is used by Docker Compose.
# None reach the browser bundle except AMAP_KEY, which is served via /api/config (AMap JS keys are public by design;
# restrict it with a domain whitelist in the AMap console).

# --- Proxy server ---
PORT=8787
# HOST=0.0.0.0  # Bind address inside the container (Compose fixes this value).
# HOST_PORT=8787  # Host port published by Docker Compose; container port stays 8787.
# TRUST_PROXY=false  # Trust X-Forwarded-* only from a known reverse proxy; true, false, hop count, or subnet list.
# ALLOWED_ORIGIN=https://jarvis.example.com  # Optional comma-separated browser origins for LLM and AMap proxy.
# RATE_LIMIT_LLM_PER_MIN=20  # LLM tokens refilled per minute per IP; 0 disables.
# RATE_LIMIT_LLM_BURST=10  # LLM burst capacity per IP; 0 disables.
# RATE_LIMIT_AMAP_PER_MIN=600  # AMap tokens refilled per minute per IP; 0 disables.
# RATE_LIMIT_AMAP_BURST=120  # AMap burst capacity per IP; 0 disables.
# HSTS=0  # Set to 1 to send HSTS on HTTPS requests only.
# CSP_REPORT_ONLY=0  # Set to 1 to observe CSP violations during real AMap key testing.
# CSP_SCRIPT_UNSAFE_EVAL=0  # Set to 1 only if the AMap script requires unsafe-eval.

# --- LLM (DeepSeek, OpenAI-compatible) ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- AMap (Gaode) ---
# JS API key (public, exposed to the browser through /api/config)
AMAP_KEY=
# Security code (secret, stays on the server; injected by the /_AMapService proxy)
AMAP_SECURITY_CODE=

# --- Build-time (Vite; not read by the Node proxy) ---
# VITE_STATIC_DEMO=true  # Build a backend-less static demo (LLM/AMap show placeholders).
# VITE_BASE=/jarvis-holographic/  # Subpath for GitHub Pages / static hosting; default /.
